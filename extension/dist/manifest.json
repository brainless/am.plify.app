{
  "manifest_version": 3,
  "name": "am.plify",
  "version": "0.1.0",
  "description": "Connects your browser to the am.plify desktop app",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "am.plify"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@am.plify.app",
      "strict_min_version": "128.0"
    }
  }
}
